{
  "name": "pulseboard",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "prisma:generate": "npm --workspace server run prisma:generate",
    "prisma:migrate": "npm --workspace server run prisma:migrate --",
    "prisma:deploy": "npm --workspace server run prisma:deploy"
  },
  "devDependencies": {"concurrently": "^9.2.1"}
}
